# Sarala Birla University (SBU) Event Management Platform
# Database Configuration (PostgreSQL supported; defaults to SQLite for local development)
DATABASE_URL=sqlite:///./sbu_events.db
# For PostgreSQL (Neon/Supabase):
# DATABASE_URL=postgresql+psycopg2://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?sslmode=require

# Security & Authentication
SECRET_KEY=sbu_institution_secret_key_change_in_production_2026_super_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Default Administrator Credentials (auto-seeded if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@SBU2026

# Application Canonical Timezone
CANONICAL_TIMEZONE=Asia/Kolkata

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Environment
ENVIRONMENT=development
